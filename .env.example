# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: choose any OpenRouter model id.
# Default: google/gemma-4-31b-it:free
# Other free options:
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
#   deepseek/deepseek-chat-v3.1:free
#   google/gemma-3-27b-it:free
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_MODEL=google/gemma-4-31b-it




# Google Cloud Platform Configuration
# Required for Cloud Run deployment
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_SERVICE_NAME=mediaparty-trust-api

# Service Account Key (JSON format)
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
# This should be the base64-encoded content of your service account JSON key
# To encode: cat service-account-key.json | base64
GCP_SA_KEY=your_base64_encoded_service_account_key
